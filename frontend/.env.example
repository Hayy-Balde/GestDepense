# URL de l'API.
#
# En développement local, décommentez la ligne ci-dessous.
# En production, définir `VITE_API_URL` dans les variables d'environnement
# Vercel (Settings > Environment Variables) — ne pas la laisser valorisée ici,
# sinon un build de production viserait `localhost`.
#
# VITE_API_URL=http://localhost:12000/api/v1
VITE_API_URL=https://gestdepense-api.onrender.com/api/v1
